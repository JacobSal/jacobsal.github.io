{
  "enabledMcpjsonServers": [
    "desktop-commander",
    "mcp-docs",
    "pdf-mcp",
    "latex-server",
    "kairn",
    "firecrawl",
    "gitmcp",
    "github"
  ],
  "mcpServers": {
    "desktop-commander": {
      "command": "npx",
      "args": [
        "-y",
        "@wonderwhy-er/desktop-commander@latest"      
      ]
    },
    "mcp-docs": {
      "type": "http",
      "url": "https://modelcontextprotocol.io/mcp"
    },
    "pdf-mcp": {
      "command": "wsl",
      "args": [
        "-d",
        "ubuntu-dev",
        "bash",
        "-c",
        "source ./.venv_wsl/bin/activate && pdf-mcp"
      ]
    },
    "kairn": {
      "command":  "./.venv/Scripts/kairn.exe",
      "args": [
        "serve",
        "./brain"
      ]
    },
    "firecrawl": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "fc-27f92243bf0940da8858dcfaac0dbdb1"
      }
    },
    "gitmcp": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://gitmcp.io/JacobSal/jacobsal.github.io"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer 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"
      }
    }
  }
}
